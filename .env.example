# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB connection string (Optional: MongoDB Atlas URI or local MongoDB. Falls back to embedded Mongo document store if unset)
MONGODB_URI=

# Authentication secrets
JWT_SECRET=super_secret_jwt_key_university_auth
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_university
OTP_SECRET=university_otp_secure_secret_hash

# Email / SMTP configuration for OTP delivery (Optional: logs to console and in-app dev mailbox if unset)
EMAIL_USER=
EMAIL_PASSWORD=

# Client origin
CLIENT_URL=http://localhost:3000
PORT=3000
